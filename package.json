{
  "name": "nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "node --test tests/unit/eth.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build:demo",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
